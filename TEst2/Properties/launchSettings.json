{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "coreclr",
      "request": "launch",
      "name": "Launch ASP.NET Core App",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/TEst2/bin/Debug/net8.0/${input:executableName}.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TEst2",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/TEst2/Views"
      }
    }
  ],
  "inputs": [
    {
      "type": "promptString",
      "id": "executableName",
      "description": "Enter the name of the executable (e.g., TEst2)"
    }
  ]
}